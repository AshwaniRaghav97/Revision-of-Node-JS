<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="main w-full min-h-screen bg-zinc-900 ">
    <div class="form px-10 py-5 flex flex-col gap-5 text-white">
      <form action="/create" method="POST" >
        <input class="block px-5 py-2 w-full bg-slate-700 text-white placeholder:text-slate-400 rounded-md outline-none" type="text" placeholder="Tittle goes Here" name="tittle">
        <textarea class="mt-2 w-full px-5 py-2 bg-slate-700 text-white placeholder:text-slate-400 rounded-md outline-none" placeholder="Description goes Here" name="details"></textarea>
        <input class="bg-blue-500 text-white px-5 py-2 rounded mt-2" type="submit" value="Add Task">
      </form>
    </div>


    <div class="tasks p-10 flex flex-wrap gap-5 ">
       
      <% if(files.length > 0) { %>
        <% files.forEach((file) => { %>
          <div class="max-w-md mx-auto mt-10 p-6 bg-gray-900 border border-gray-800 rounded-2xl shadow-lg hover:border-gray-600 transition duration-300">
            <h1 class="text-2xl font-bold text-white mb-3">
              <%= file.replace('.txt', '') %>
            </h1>

            <p class="text-gray-400 text-sm leading-7 break-words">
                    <%= file.content %>
                </p>
          </div>
        
        <% }) %>
      <% } else { %>
        <p class="text-white">No tasks available.</p>
      <% } %>

      

      </div>
    </div>

  </div>

  <script src="/javascripts/script.js"></script>
</body>
</html>